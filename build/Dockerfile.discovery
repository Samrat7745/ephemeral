# Build from the repository root: docker build -f build/Dockerfile.discovery -t discovery .
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY pkg ./pkg
RUN CGO_ENABLED=0 go build -trimpath -o /out/discovery ./cmd/discovery

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/discovery /usr/local/bin/discovery
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/discovery"]
