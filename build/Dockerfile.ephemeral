# Build from the repository root:
#   docker build -f build/Dockerfile.ephemeral -t ephemeral --build-arg BASE=<image with MP-SPDZ and a /ko-app/ephemeral entrypoint> .
#
# The ephemeral service needs the MP-SPDZ runtime (compiler, virtual machine, Player-Data). Upstream publishes it as
# ghcr.io/carbynestack/ephemeral-spdz-base-image (used via ko, see .ko.yaml), which is not publicly pullable. Any released
# ghcr.io/carbynestack/ephemeral/ephemeral image carries the same runtime, so the default replaces just the Go binary.
ARG BASE=ghcr.io/carbynestack/ephemeral/ephemeral:0.3.1
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY pkg ./pkg
RUN CGO_ENABLED=0 go build -trimpath -o /out/ephemeral ./cmd/ephemeral

FROM ${BASE}
COPY --from=build /out/ephemeral /ko-app/ephemeral
